---
import Base from './Base.astro';

const { frontmatter } = Astro.props;
const date = new Date(frontmatter.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base title={`${frontmatter.title} · Nidhi Rajani`} description={frontmatter.summary}>
  <article class="post narrow">
    <p class="eyebrow"><a href="/writing/">Writing</a></p>
    <h1>{frontmatter.title}</h1>
    <p class="meta">{date} · Dotted numbers link to the line they come from.</p>
    <slot />
    <hr style="margin:2.5rem 0;border:0;border-top:1px solid var(--line)" />
    <p class="muted small">
      Questions or a role where this fits? <a href="mailto:nidhi.rajani.ds@gmail.com">nidhi.rajani.ds@gmail.com</a> ·
      <a href="https://www.linkedin.com/in/nidhirajani">LinkedIn</a>
    </p>
  </article>
</Base>
